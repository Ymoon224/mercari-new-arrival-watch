{
  "manifest_version": 3,
  "name": "Mercari 上新提醒",
  "description": "多个关键词分别设置检查间隔，监控最新非推广商品并推送提醒。",
  "version": "2.0.0",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "storage", "notifications"],
  "host_permissions": ["https://jp.mercari.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "https://sctapi.ftqq.com/*", "https://www.pushplus.plus/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "查看 Mercari 上新监控" },
  "options_ui": { "page": "dashboard.html", "open_in_tab": true },
  "icons": { "128": "icon.png" },
  "content_scripts": [{
    "matches": ["https://jp.mercari.com/search*"],
    "js": ["shared.js", "collector.js", "content.js"],
    "run_at": "document_idle"
  }]
}

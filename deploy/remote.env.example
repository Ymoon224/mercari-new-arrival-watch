# Copy outside the repository, e.g. /etc/mercari-watch.env; chmod 600.
# Runtime data and credentials are never written into the source checkout.
MERCARI_DATA_DIR=/var/lib/mercari-watch
MERCARI_PLUGIN_ROOT=/opt/mercari-runtime/node_modules/@tencent-weixin/openclaw-weixin
MERCARI_HOST=127.0.0.1
MERCARI_PORT=17870
TZ=Asia/Shanghai

# Must be the HTTPS origin only, without /api or a URL path.
MERCARI_PUBLIC_URL=https://watch.example.com
MERCARI_TRUST_PROXY=1

# Set the actual extension ID shown in your browser's extension management page.
# Do not use '*'. Separate additional approved origins with commas.
# MERCARI_ALLOWED_ORIGINS=chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
MERCARI_ALLOWED_ORIGINS=

# Omit to generate /var/lib/mercari-watch/admin-token on first start (mode 600).
# If set, use exactly 64 hexadecimal characters; never commit the real value.
# MERCARI_ADMIN_TOKEN=

# Global Mercari request spacing and bounded collection workers.
MERCARI_MIN_REQUEST_GAP_MS=5000
MERCARI_MAX_CONCURRENT=1
MERCARI_COLLECTION_TIMEOUT_MS=45000
